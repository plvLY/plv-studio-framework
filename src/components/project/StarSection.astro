---
import type { Work } from '../../lib/contracts';

interface Props {
  star: Work['star'];
}

const { star } = Astro.props;
const blocks = [
  { index: '01', title: '痛点', text: star.problem },
  { index: '02', title: '方案', text: star.solution },
  { index: '03', title: '价值', text: star.value },
];
---

<div class="star-section">
  {
    blocks.map((block) => (
      <article class="star-section__card">
        <p class="star-section__index">{block.index}</p>
        <h3 class="star-section__title">{block.title}</h3>
        <p class="star-section__text">{block.text}</p>
      </article>
    ))
  }
</div>

<style>
  .star-section {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .star-section__card {
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }

  .star-section__index {
    margin: 0 0 var(--space-2);
    color: var(--color-brand);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
  }

  .star-section__title {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
  }

  .star-section__text {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.7;
  }

  @media (max-width: 47.999rem) {
    .star-section {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

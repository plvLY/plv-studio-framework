---
import '../styles/global.css';
import { getProfile } from '../lib/data-source';
import SkipLink from '../components/layout/SkipLink.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import ThemeScript from '../components/layout/ThemeScript.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const profile = await getProfile();
const pageTitle = title ?? profile.seo.defaultTitle;
const pageDescription = description ?? profile.seo.defaultDescription;
---

<!doctype html>
<html lang={profile.seo.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <ThemeScript />
    <slot name="head" />
    <!-- 接入 PLVMonitor：仅生产构建注入，本地开发流量不计入统计 -->
    {import.meta.env.PROD && (
      <>
        <script
          is:inline
          defer
          src="https://plv-monitor.netlify.app/tracker/plv-tracker.iife.js"
        ></script>
        <script is:inline>
          window.addEventListener('DOMContentLoaded', () => {
            if (!window.PLVSiteMonitor) return;

            const tracker = window.PLVSiteMonitor.init({
              siteId: 'ac49899f-dddb-4451-bd11-f501d57a2ebb',
              endpoint: 'https://plv-monitor.netlify.app/api/collect',
            });

            tracker.startPageTracking();
          });
        </script>
      </>
    )}
  </head>
  <body>
    <SkipLink />
    <SiteHeader brandName={profile.brand.studioName} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter profile={profile} />

    <script>
      // 英文与数字统一使用等宽字体：包裹文本节点，跳过代码、图标等区域。
      const monoPattern = /[A-Za-z0-9][A-Za-z0-9._+#/%-]*/g;
      const skipSelector = 'script, style, code, pre, kbd, samp, textarea, svg, .u-mono';

      const textNodes: Text[] = [];
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);

      while (walker.nextNode()) {
        const node = walker.currentNode as Text;
        const parent = node.parentElement;

        if (!parent || parent.closest(skipSelector)) {
          continue;
        }

        monoPattern.lastIndex = 0;

        if (monoPattern.test(node.nodeValue ?? '')) {
          textNodes.push(node);
        }
      }

      textNodes.forEach((node) => {
        const text = node.nodeValue ?? '';
        const fragment = document.createDocumentFragment();
        let lastIndex = 0;
        let match: RegExpExecArray | null;

        monoPattern.lastIndex = 0;

        while ((match = monoPattern.exec(text)) !== null) {
          if (match.index > lastIndex) {
            fragment.append(text.slice(lastIndex, match.index));
          }

          const span = document.createElement('span');
          span.className = 'u-mono';
          span.textContent = match[0];
          fragment.append(span);
          lastIndex = match.index + match[0].length;
        }

        if (lastIndex < text.length) {
          fragment.append(text.slice(lastIndex));
        }

        node.replaceWith(fragment);
      });
    </script>
  </body>
</html>

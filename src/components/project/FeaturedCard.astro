---
import type { Work } from '../../lib/contracts';
import StatusBadge from '../ui/StatusBadge.astro';
import TechBadge from '../ui/TechBadge.astro';

interface Props {
  work: Work;
  href: string;
  coverUrl: string;
  /** 主推项目编号，例如 01。 */
  index?: string;
}

const { work, href, coverUrl, index } = Astro.props;
const tags = work.techStack.slice(0, 4);
---

<article class="featured-card">
  <div class="featured-card__cover">
    <img
      src={coverUrl}
      alt={work.coverAlt}
      width="1280"
      height="720"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="featured-card__body">
    <div class="featured-card__meta">
      {index && <span class="featured-card__index">{index}</span>}
      <StatusBadge kind="project" status={work.status} />
    </div>

    <h3 class="featured-card__title">
      <a class="featured-card__link" href={href}>{work.title}</a>
    </h3>
    <p class="featured-card__summary">{work.summary}</p>

    <div class="featured-card__footer">
      <ul class="featured-card__tags" aria-label="技术栈">
        {tags.map((tag) => <li><TechBadge label={tag} /></li>)}
      </ul>
      <span class="featured-card__more" aria-hidden="true">查看项目 →</span>
    </div>
  </div>
</article>

<style>
  .featured-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .featured-card:hover,
  .featured-card:focus-within {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .featured-card:focus-within {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .featured-card__cover {
    position: relative;
    aspect-ratio: 2.4 / 1;
    overflow: hidden;
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }

  .featured-card__cover img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .featured-card:hover .featured-card__cover img,
  .featured-card:focus-within .featured-card__cover img {
    transform: scale(1.02);
  }

  .featured-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .featured-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .featured-card__index {
    color: var(--color-brand);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
  }

  .featured-card__title {
    margin: 0;
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-heading);
    letter-spacing: -0.02em;
  }

  .featured-card__link {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .featured-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .featured-card__summary {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--line-height-body);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .featured-card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .featured-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured-card__more {
    color: var(--color-brand);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card:hover .featured-card__cover img,
    .featured-card:focus-within .featured-card__cover img {
      transform: none;
    }
  }

  @media (max-width: 47.999rem) {
    .featured-card__cover {
      aspect-ratio: 16 / 9;
    }

    .featured-card__body {
      padding: var(--space-5);
    }

    .featured-card__title {
      font-size: var(--font-size-xl);
    }

    .featured-card__summary {
      font-size: var(--font-size-sm);
    }
  }
</style>

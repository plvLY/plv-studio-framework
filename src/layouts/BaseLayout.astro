---
import '../styles/global.css';
import { getProfile } from '../lib/data-source';
import SkipLink from '../components/layout/SkipLink.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import ThemeScript from '../components/layout/ThemeScript.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const profile = await getProfile();
const pageTitle = title ?? profile.seo.defaultTitle;
const pageDescription = description ?? profile.seo.defaultDescription;
---

<!doctype html>
<html lang={profile.seo.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <ThemeScript />
    <slot name="head" />
    <!-- 接入PLVMonitor：仅生产构建注入（本地开发流量不计入统计） -->
    {import.meta.env.PROD && (
      <script
        is:inline
        src="https://plv-monitor.netlify.app/tracker/plv-tracker.iife.js"
      ></script>
      <script>
        (() => {
          const tracker = PLVSiteMonitor.init({
            siteId: "ac49899f-dddb-4451-bd11-f501d57a2ebb",
            endpoint: "https://plv-monitor.netlify.app/api/collect",
          })
          tracker.startPageTracking()
        })()
      </script>
    )}
  </head>
  <body>
    <SkipLink />
    <SiteHeader brandName={profile.brand.studioName} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter profile={profile} />
  </body>
</html>

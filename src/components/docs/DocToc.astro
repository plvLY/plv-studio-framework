---
interface TocItem {
  id: string;
  text: string;
  level?: number;
}

interface Props {
  items: readonly TocItem[];
  activeId?: string;
  title?: string;
  /** 详情页用于滚动高亮的本页目录。 */
  page?: boolean;
  /** 文档页启用“随滚动高亮当前章节”。 */
  scrollspy?: boolean;
}

const { items, activeId, title = '目录', page = false, scrollspy = false } = Astro.props;
---

<nav
  class="doc-toc"
  aria-label={title}
  data-page-toc={page ? '' : undefined}
  data-doc-toc-scrollspy={scrollspy ? '' : undefined}
>
  <p class="doc-toc__title">{title}</p>
  <ol>
    {
      items.map((item) => (
        <li data-level={item.level ?? 2}>
          <a
            href={`#${item.id}`}
            aria-current={item.id === activeId ? 'location' : undefined}
          >
            {item.text}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  document.querySelectorAll<HTMLElement>('[data-doc-toc-scrollspy]').forEach((toc) => {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const targets = links.map((link) => {
      const id = link.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    });

    let activeIndex = -1;
    let lockUntil = 0;

    const setActive = (nextIndex: number) => {
      if (nextIndex === activeIndex) {
        return;
      }

      activeIndex = nextIndex;
      links.forEach((link, index) => {
        if (index === nextIndex) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    const update = () => {
      // 点击目录后，锚点跳转触发的滚动不应把高亮改回其它章节。
      if (Date.now() < lockUntil) {
        return;
      }

      const offset = 160;
      let nextIndex = 0;

      targets.forEach((target, index) => {
        if (target && target.getBoundingClientRect().top <= offset) {
          nextIndex = index;
        }
      });

      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
        nextIndex = links.length - 1;
      }

      setActive(nextIndex);
    };

    links.forEach((link, index) => {
      link.addEventListener('click', () => {
        setActive(index);
        lockUntil = Date.now() + 900;
      });
    });

    window.addEventListener('hashchange', () => {
      const index = links.findIndex((link) => link.hash === window.location.hash);

      if (index >= 0) {
        setActive(index);
        lockUntil = Date.now() + 900;
      }
    });

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  });
</script>

<style>
  .doc-toc {
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
    max-height: calc(100vh - var(--header-height) - var(--space-8));
    overflow-y: auto;
  }

  .doc-toc__title {
    margin: 0 0 var(--space-3);
    color: var(--color-text-tertiary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
  }

  .doc-toc ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .doc-toc a {
    display: block;
    padding: 4px 8px;
    border-left: 2px solid transparent;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.5;
    text-decoration: none;
  }

  .doc-toc a:hover {
    color: var(--color-text-primary);
  }

  .doc-toc a[aria-current='location'] {
    border-left-color: var(--color-brand);
    color: var(--color-brand);
  }

  .doc-toc li[data-level='3'] a {
    padding-left: 20px;
    font-size: var(--font-size-xs);
  }
</style>

---
interface Props {
  /** 父级链接，例如“作品”。 */
  parentHref: string;
  parentLabel: string;
  current: string;
}

const { parentHref, parentLabel, current } = Astro.props;
---

<nav class="breadcrumb" aria-label="面包屑">
  <ol>
    <li><a href={parentHref}>{parentLabel}</a></li>
    <li aria-current="page">{current}</li>
  </ol>
</nav>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumb li + li::before {
    content: '/';
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-text-primary);
    text-decoration: underline;
  }

  .breadcrumb li[aria-current='page'] {
    color: var(--color-text-primary);
  }
</style>

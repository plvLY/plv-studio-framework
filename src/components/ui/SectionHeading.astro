---
interface Props {
  /** 区块编号，例如 01；不传则不显示。 */
  index?: string | number;
  kicker?: string;
  title: string;
  description?: string;
  linkHref?: string;
  linkLabel?: string;
}

const {
  index,
  kicker,
  title,
  description,
  linkHref,
  linkLabel = '查看全部',
} = Astro.props;
---

<header class="section-heading" data-has-index={index !== undefined ? '' : undefined}>
  {index !== undefined && <p class="section-heading__index">{index}</p>}

  <div class="section-heading__text">
    {kicker && <p class="section-heading__kicker">{kicker}</p>}
    <h2 class="section-heading__title">{title}</h2>
    {description && <p class="section-heading__description">{description}</p>}
  </div>

  {
    linkHref && (
      <a class="section-heading__link" href={linkHref}>
        {linkLabel} ↗
      </a>
    )
  }
</header>

<style>
  .section-heading {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-2) var(--space-6);
    margin-bottom: var(--space-8);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  /* 编号独占一行，标题区与右侧链接在同一行 */
  .section-heading__index {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-gray-500);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-regular);
    line-height: 1.6;
    letter-spacing: 0.08em;
  }

  .section-heading__kicker {
    margin: 0 0 var(--space-1);
    color: var(--color-text-secondary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-heading__title {
    margin: 0;
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-heading);
    letter-spacing: -0.02em;
  }

  .section-heading__description {
    max-width: 52em;
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--line-height-body);
  }

  .section-heading__link {
    align-self: end;
    flex-shrink: 0;
    padding-bottom: 2px;
    border-bottom: var(--border-width) solid currentColor;
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .section-heading__link:hover {
    color: var(--color-brand-hover);
  }

  @media (max-width: 47.999rem) {
    .section-heading {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--space-2);
      margin-bottom: var(--space-6);
    }

    .section-heading[data-has-index] {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--space-4);
    }

    .section-heading__index {
      grid-column: auto;
    }

    .section-heading__title {
      font-size: var(--font-size-2xl);
    }

    .section-heading__description {
      font-size: var(--font-size-sm);
    }

    .section-heading__link {
      justify-self: start;
    }

    .section-heading[data-has-index] .section-heading__link {
      grid-column: 2;
    }
  }
</style>

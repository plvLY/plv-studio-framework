---
import type { DevelopingWork } from '../../lib/derive';
import StageRail from '../ui/StageRail.astro';
import StatusBadge from '../ui/StatusBadge.astro';

interface Props {
  item: DevelopingWork;
  href: string;
}

const { item, href } = Astro.props;
const { work, project, journey } = item;
const completedStages = project.stages.filter((stage) => stage.status === 'completed').length;
---

<article class="developing-card">
  <div class="developing-card__head">
    <StatusBadge kind="project" status={work.status} />
    <p class="developing-card__updated">
      最近更新 <time datetime={journey.recentUpdate}>{journey.recentUpdate.slice(5)}</time>
    </p>
  </div>

  <h3 class="developing-card__title">
    <a class="developing-card__link" href={href}>{work.title}</a>
  </h3>
  <p class="developing-card__summary">{work.summary}</p>

  <p class="developing-card__journey">
    <span>起始 <time datetime={journey.startDate}>{journey.startDate.slice(5)}</time></span>
    <span class="developing-card__arrow" aria-hidden="true">→</span>
    <span>更新 <time datetime={journey.recentUpdate}>{journey.recentUpdate.slice(5)}</time></span>
  </p>

  <div class="developing-card__progress">
    <div class="developing-card__stage-meta">
      <span class="developing-card__stage-current">
        阶段 {journey.currentStage} · {journey.currentStageName}
      </span>
      <span class="developing-card__stage-count">
        {completedStages} / {project.stages.length} 已完成
      </span>
    </div>
    <StageRail stages={project.stages} currentStage={project.currentStage} />
  </div>
</article>

<style>
  .developing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .developing-card:hover,
  .developing-card:focus-within {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  .developing-card:focus-within {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .developing-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .developing-card__updated {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 12px;
  }

  .developing-card__updated time {
    font-family: var(--font-family-mono);
    font-variant-numeric: tabular-nums;
  }

  .developing-card__title {
    margin: 0;
    font-size: 20px;
  }

  .developing-card__link {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .developing-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .developing-card__summary {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .developing-card__journey {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 12px;
  }

  .developing-card__journey time {
    font-family: var(--font-family-mono);
    font-variant-numeric: tabular-nums;
  }

  .developing-card__arrow {
    color: var(--color-text-muted);
  }

  .developing-card__progress {
    display: grid;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .developing-card__stage-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    font-size: 12px;
  }

  .developing-card__stage-current {
    color: var(--color-brand);
    font-weight: 600;
  }

  .developing-card__stage-count {
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 47.999rem) {
    .developing-card {
      padding: var(--space-4);
    }
  }
</style>

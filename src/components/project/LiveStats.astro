---
import type { LiveStats as Stats } from '../../lib/derive';

interface Props {
  stats: Stats;
}

const { stats } = Astro.props;
const items = [
  { label: '公开作品', value: String(stats.works), unit: '个', date: null },
  { label: '已完成阶段', value: String(stats.completedStages), unit: '个', date: null },
  { label: '设计文档', value: String(stats.publicDocuments), unit: '份', date: null },
  {
    label: '最近更新',
    value: stats.recentUpdate ? stats.recentUpdate.slice(5).replace('-', '.') : '—',
    unit: '',
    date: stats.recentUpdate,
  },
];
---

<dl class="live-stats">
  {
    items.map((item) => (
      <div class:list={['live-stats__item', { 'live-stats__item--date': item.date }]}>
        <dt class="live-stats__label">{item.label}</dt>
        <dd class="live-stats__value">
          {item.date ? (
            <time datetime={item.date}>{item.value}</time>
          ) : (
            <>
              {item.value}
              <span class="live-stats__unit">{item.unit}</span>
            </>
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .live-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-border);
  }

  .live-stats__item {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface-raised);
  }

  .live-stats__label {
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
  }

  .live-stats__value {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .live-stats__unit {
    margin-left: 4px;
    color: var(--color-text-tertiary);
    font-family: var(--font-family-sans);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0;
  }

  .live-stats__item--date .live-stats__value {
    font-size: var(--font-size-2xl);
  }

  @media (max-width: 63.999rem) {
    .live-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.999rem) {
    .live-stats__item {
      gap: var(--space-1);
      padding: var(--space-4);
    }

    .live-stats__value {
      font-size: var(--font-size-2xl);
    }

    .live-stats__item--date .live-stats__value {
      font-size: var(--font-size-xl);
    }
  }
</style>

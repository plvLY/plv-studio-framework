---
interface Props {
  percent: number;
  label?: string;
}

const { percent, label } = Astro.props;
const value = Math.min(100, Math.max(0, Math.round(percent)));
const ariaLabel = label ? `${label}，进度 ${value}%` : `进度 ${value}%`;
---

<div class="progress">
  <div class="progress__meta">
    <span class="progress__label">{label ?? ''}</span>
    <span class="progress__value">{value}%</span>
  </div>
  <div
    class="progress__track"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={value}
    aria-label={ariaLabel}
  >
    <div class="progress__fill" style={`width: ${value}%`}></div>
  </div>
</div>

<style>
  .progress {
    display: grid;
    gap: var(--space-1);
    width: 100%;
  }

  .progress__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    font-size: 12px;
  }

  .progress__value {
    font-family: var(--font-family-mono);
    font-variant-numeric: tabular-nums;
  }

  .progress__track {
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-border);
  }

  .progress__fill {
    height: 100%;
    border-radius: 999px;
    background: var(--color-brand);
  }
</style>

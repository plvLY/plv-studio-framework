---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  linkHref?: string;
  linkLabel?: string;
}

const { kicker, title, description, linkHref, linkLabel = '查看全部' } = Astro.props;
---

<header class="section-heading">
  <div class="section-heading__text">
    {kicker && <p class="section-heading__kicker">{kicker}</p>}
    <h2 class="section-heading__title">{title}</h2>
    {description && <p class="section-heading__description">{description}</p>}
  </div>
  {
    linkHref && (
      <a class="section-heading__link" href={linkHref}>
        {linkLabel}
      </a>
    )
  }
</header>

<style>
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-heading__kicker {
    margin: 0 0 var(--space-1);
    color: var(--color-text-secondary);
    font-family: var(--font-family-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-heading__title {
    margin: 0;
    font-size: 30px;
    line-height: 1.3;
  }

  .section-heading__description {
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    font-size: 14px;
  }

  .section-heading__link {
    flex-shrink: 0;
    color: var(--color-brand);
    font-size: 14px;
    text-decoration: none;
  }

  .section-heading__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 47.999rem) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }

    .section-heading__title {
      font-size: 24px;
    }
  }
</style>

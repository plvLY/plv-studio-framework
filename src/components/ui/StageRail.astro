---
import { STAGE_STATUS_LABELS, stageNameOf } from '../../lib/constants';
import type { StageProgress } from '../../lib/contracts';

interface Props {
  stages: readonly StageProgress[];
  currentStage?: number;
}

const { stages, currentStage } = Astro.props;

/** 八阶段等宽展示用的短名称；完整名称仍用于 aria-label 与 title。 */
const STAGE_SHORT_LABELS: Record<string, string> = {
  planning: '规划',
  requirements: '需求',
  design: '设计',
  architecture: '架构',
  development: '开发',
  testing: '测试',
  deployment: '部署',
  operations: '迭代',
};
---

<div class="stage-rail" role="list" aria-label="八阶段进度">
  {
    stages.map((stage) => (
      <div
        class="stage-rail__item"
        role="listitem"
        data-status={stage.status}
        aria-current={stage.stage === currentStage ? 'step' : undefined}
        aria-label={`阶段 ${stage.stage} ${stageNameOf(stage.key)} ${STAGE_STATUS_LABELS[stage.status]}`}
        title={`阶段 ${stage.stage} ${stageNameOf(stage.key)} · ${STAGE_STATUS_LABELS[stage.status]}`}
      >
        <span class="stage-rail__bar" aria-hidden="true" />
        <span class="stage-rail__name" aria-hidden="true">
          {STAGE_SHORT_LABELS[stage.key] ?? stageNameOf(stage.key)}
        </span>
      </div>
    ))
  }
</div>

<style>
  .stage-rail {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 4px;
    width: 100%;
  }

  .stage-rail__item {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .stage-rail__bar {
    display: block;
    height: 6px;
    border-radius: 2px;
    background: var(--color-border);
  }

  .stage-rail__item[data-status='completed'] .stage-rail__bar {
    background: var(--color-success);
  }

  .stage-rail__item[data-status='in-progress'] .stage-rail__bar {
    background: var(--color-brand);
    box-shadow: inset -1px 0 0 rgb(255 255 255 / 60%);
  }

  .stage-rail__name {
    color: var(--color-text-muted);
    font-size: 10px;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
  }

  .stage-rail__item[data-status='completed'] .stage-rail__name {
    color: var(--color-text-secondary);
  }

  .stage-rail__item[aria-current='step'] .stage-rail__name {
    color: var(--color-brand);
    font-weight: 600;
  }
</style>

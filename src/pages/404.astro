---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="404 — PLV Studio" description="你访问的页面不存在。">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="container not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">这个页面不存在</h1>
    <p class="not-found__text">可能已移动，或从未存在。</p>
    <div class="not-found__actions">
      <Button href="/">返回首页</Button>
      <Button variant="secondary" href="/projects/">查看作品</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 520px;
    padding-block: 120px;
    text-align: center;
  }

  .not-found__code {
    margin: 0;
    color: var(--color-brand);
    font-family: var(--font-family-mono);
    font-size: 72px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .not-found__title {
    margin: var(--space-4) 0 0;
    font-size: 24px;
  }

  .not-found__text {
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    font-size: 16px;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  @media (max-width: 47.999rem) {
    .not-found {
      padding-block: 80px;
    }

    .not-found__code {
      font-size: 60px;
    }
  }
</style>

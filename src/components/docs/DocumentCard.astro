---
import type { DocumentMeta } from '../../lib/contracts';

interface Props {
  document: DocumentMeta;
  href: string;
}

const { document, href } = Astro.props;
---

<article class="document-card">
  <p class="document-card__stage">阶段 {document.stage}</p>
  <h3 class="document-card__title">
    <a class="document-card__link" href={href}>{document.title}</a>
  </h3>
  {document.summary && <p class="document-card__summary">{document.summary}</p>}
  <p class="document-card__date">
    <time datetime={document.date}>{document.date}</time>
  </p>
</article>

<style>
  .document-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .document-card:hover,
  .document-card:focus-within {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .document-card:focus-within {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .document-card__stage {
    margin: 0;
    color: var(--color-brand);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
  }

  .document-card__title {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
  }

  .document-card__link {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .document-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .document-card__summary {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .document-card__date {
    margin: 0;
    color: var(--color-text-tertiary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    font-variant-numeric: tabular-nums;
  }
</style>

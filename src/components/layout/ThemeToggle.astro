---
interface Props {
  /** 同一页面存在多个开关时传入唯一 id，避免 aria-controls 冲突。 */
  id?: string;
}

const { id = 'theme-menu' } = Astro.props;
---

<div class="theme-toggle" data-theme-toggle>
  <button
    type="button"
    class="theme-toggle__trigger"
    aria-label="切换主题"
    aria-expanded="false"
    aria-controls={id}
    data-theme-trigger
  >
    <svg
      class="theme-toggle__icon"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="8"></circle>
      <path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor" stroke="none"></path>
    </svg>
  </button>

  <div
    class="theme-toggle__menu"
    id={id}
    role="radiogroup"
    aria-label="主题模式"
    data-theme-menu
    hidden
  >
    <button
      type="button"
      class="theme-toggle__option"
      role="radio"
      aria-checked="false"
      data-theme-option="light"
    >
      <span class="theme-toggle__dot" aria-hidden="true"></span>
      浅色
    </button>
    <button
      type="button"
      class="theme-toggle__option"
      role="radio"
      aria-checked="false"
      data-theme-option="dark"
    >
      <span class="theme-toggle__dot" aria-hidden="true"></span>
      暗色
    </button>
    <button
      type="button"
      class="theme-toggle__option"
      role="radio"
      aria-checked="false"
      data-theme-option="system"
    >
      <span class="theme-toggle__dot" aria-hidden="true"></span>
      跟随系统
    </button>
  </div>
</div>

<script>
  type ThemeMode = 'light' | 'dark' | 'system';

  const storageKey = 'plv-theme';

  const isMode = (value: string | undefined): value is ThemeMode =>
    value === 'light' || value === 'dark' || value === 'system';

  const resolveTheme = (mode: ThemeMode): 'light' | 'dark' => {
    if (mode !== 'system') {
      return mode;
    }

    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  const currentMode = (): ThemeMode => {
    const mode = document.documentElement.dataset.themeMode;
    return isMode(mode) ? mode : 'system';
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((root) => {
    if (!(root instanceof HTMLElement)) {
      return;
    }

    const trigger = root.querySelector('[data-theme-trigger]');
    const menu = root.querySelector('[data-theme-menu]');
    const options = Array.from(root.querySelectorAll<HTMLElement>('[data-theme-option]'));

    if (
      !(trigger instanceof HTMLButtonElement) ||
      !(menu instanceof HTMLElement) ||
      options.length === 0
    ) {
      return;
    }

    const markChecked = () => {
      const mode = currentMode();

      options.forEach((option) => {
        option.setAttribute('aria-checked', String(option.dataset.themeOption === mode));
      });
    };

    const applyMode = (mode: string | undefined) => {
      if (!isMode(mode)) {
        return;
      }

      const theme = resolveTheme(mode);
      const element = document.documentElement;
      element.dataset.theme = theme;
      element.dataset.themeMode = mode;
      element.style.colorScheme = theme;

      const themeColor = document.querySelector('meta[name="theme-color"]');
      themeColor?.setAttribute('content', theme === 'dark' ? '#111111' : '#ffffff');

      try {
        if (mode === 'system') {
          localStorage.removeItem(storageKey);
        } else {
          localStorage.setItem(storageKey, mode);
        }
      } catch {
        // 隐私模式下不可写时，仅当前页面生效。
      }

      markChecked();
      document.dispatchEvent(new CustomEvent('plv:theme-change'));
    };

    const openMenu = () => {
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');

      const checked = options.find((option) => option.getAttribute('aria-checked') === 'true');
      (checked ?? options[0]).focus();
    };

    const closeMenu = (returnFocus: boolean) => {
      if (menu.hidden) {
        return;
      }

      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');

      if (returnFocus) {
        trigger.focus();
      }
    };

    trigger.addEventListener('click', () => {
      if (menu.hidden) {
        openMenu();
      } else {
        closeMenu(true);
      }
    });

    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        openMenu();
      }
    });

    options.forEach((option, index) => {
      option.addEventListener('click', () => {
        applyMode(option.dataset.themeOption);
        closeMenu(true);
      });

      option.addEventListener('keydown', (event) => {
        const keys = ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End'];

        if (!keys.includes(event.key)) {
          return;
        }

        event.preventDefault();

        let nextIndex = index;

        if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = options.length - 1;
        } else if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
          nextIndex = (index + 1) % options.length;
        } else {
          nextIndex = (index - 1 + options.length) % options.length;
        }

        options[nextIndex].focus();
        applyMode(options[nextIndex].dataset.themeOption);
      });
    });

    root.addEventListener('focusout', (event) => {
      const nextTarget = event.relatedTarget;

      if (!(nextTarget instanceof Node) || !root.contains(nextTarget)) {
        closeMenu(false);
      }
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) {
        closeMenu(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        event.stopPropagation();
        closeMenu(true);
      }
    });

    document.addEventListener('plv:theme-change', markChecked);

    markChecked();
  });
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
  }

  .theme-toggle__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-background);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .theme-toggle__trigger:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
  }

  .theme-toggle__trigger[aria-expanded='true'] {
    color: var(--color-brand);
    border-color: var(--color-brand);
    background: var(--color-brand-soft);
  }

  .theme-toggle__icon {
    display: block;
  }

  .theme-toggle__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 50;
    display: grid;
    gap: 2px;
    min-width: 168px;
    padding: 6px;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-md);
  }

  .theme-toggle__menu[hidden] {
    display: none;
  }

  .theme-toggle__option {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 44px;
    padding: 0 10px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-size: var(--font-size-sm);
    text-align: left;
    cursor: pointer;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .theme-toggle__option:hover {
    color: var(--color-text-primary);
    background: var(--color-surface);
  }

  .theme-toggle__option[aria-checked='true'] {
    color: var(--color-brand-hover);
    background: var(--color-brand-soft);
  }

  .theme-toggle__dot {
    width: 10px;
    height: 10px;
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: 50%;
  }

  .theme-toggle__option[aria-checked='true'] .theme-toggle__dot {
    border-color: var(--color-brand);
    background: var(--color-brand);
  }
</style>

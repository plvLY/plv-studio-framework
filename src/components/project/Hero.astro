---
import type { Profile } from '../../lib/contracts';
import Button from '../ui/Button.astro';
import HeroVisual from './HeroVisual.astro';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const positioning = profile.brand.positioning.split('（')[0].trim();

const bioParts = profile.author.bio.split('，');
const bioLead = bioParts[0];
const bioTail = bioParts.slice(1).join('，');
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__kicker">{positioning}</p>

      <h1 class="hero__title">
        <span class="hero__title-line">{bioLead}</span>
        {bioTail && <span class="hero__title-line hero__title-line--accent">{bioTail}</span>}
      </h1>

      <p class="hero__subtitle">{profile.home.heroSubtitle}</p>

      <div class="hero__actions">
        <Button href="#featured">查看精选作品</Button>
        <Button variant="secondary" href="/about/">了解工作方式</Button>
      </div>

      <p class="hero__author">{profile.author.name} · {profile.author.title}</p>
    </div>

    <div class="hero__visual">
      <HeroVisual />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-20) var(--space-16);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-16);
    align-items: center;
  }

  .hero__kicker {
    margin: 0 0 var(--space-3);
    color: var(--color-text-secondary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(42px, 6vw, var(--font-size-display));
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: -0.03em;
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-line--accent {
    color: var(--color-brand);
  }

  .hero__subtitle {
    max-width: 34em;
    margin: var(--space-6) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-body);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero__author {
    margin: var(--space-8) 0 0;
    color: var(--color-text-tertiary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
  }

  .hero__visual {
    width: 100%;
    max-width: 460px;
    margin-left: auto;
  }

  @media (max-width: 63.999rem) {
    .hero {
      padding-block: var(--space-12) var(--space-10);
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
      align-items: start;
    }

    .hero__visual {
      max-width: 360px;
      margin-inline: auto;
    }
  }

  @media (max-width: 47.999rem) {
    .hero {
      padding-block: var(--space-10) var(--space-8);
    }

    .hero__title {
      font-size: 42px;
    }

    .hero__subtitle {
      font-size: var(--font-size-base);
    }

    .hero__visual {
      max-width: 280px;
    }
  }
</style>

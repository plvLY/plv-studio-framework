---
import type { Work } from '../../lib/contracts';
import StatusBadge from '../ui/StatusBadge.astro';
import TechBadge from '../ui/TechBadge.astro';

interface Props {
  work: Work;
  href: string;
  coverUrl: string;
}

const { work, href, coverUrl } = Astro.props;
const tags = work.techStack.slice(0, 4);
---

<article class="featured-card">
  <div class="featured-card__bar" aria-hidden="true">
    <span class="featured-card__dot featured-card__dot--red"></span>
    <span class="featured-card__dot featured-card__dot--yellow"></span>
    <span class="featured-card__dot featured-card__dot--green"></span>
    <span class="featured-card__path">~/works/{work.slug}</span>
  </div>

  <div class="featured-card__body">
    <div class="featured-card__text">
      <p class="featured-card__prompt">$ open {work.slug}</p>
      <h3 class="featured-card__title">
        <a class="featured-card__link" href={href}>{work.title}</a>
      </h3>
      <p class="featured-card__summary">{work.summary}</p>

      <div class="featured-card__meta">
        <StatusBadge kind="project" status={work.status} />
        <ul class="featured-card__tags" aria-label="技术栈">
          {tags.map((tag) => <li><TechBadge label={tag} /></li>)}
        </ul>
      </div>
    </div>

    <div class="featured-card__cover">
      <img
        src={coverUrl}
        alt={work.coverAlt}
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</article>

<style>
  .featured-card {
    --color-surface: #1e293b;
    --color-border: #334155;
    --color-border-strong: #475569;
    --color-text-primary: #e5e7eb;
    --color-text-secondary: #cbd5e1;
    --color-text-muted: #94a3b8;
    --color-brand: #60a5fa;
    --color-success: #4ade80;
    --color-page: #0f172a;

    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--border-width) solid var(--color-terminal-border);
    border-radius: var(--radius-xl);
    background: var(--color-terminal);
    color: var(--color-terminal-text);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .featured-card:hover,
  .featured-card:focus-within {
    border-color: #475569;
    box-shadow: var(--shadow-md);
  }

  .featured-card:focus-within {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .featured-card__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding-inline: var(--space-3);
    border-bottom: var(--border-width) solid #1e293b;
    background: rgb(255 255 255 / 4%);
  }

  .featured-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    opacity: 0.75;
  }

  .featured-card__dot--red {
    background: #f87171;
  }

  .featured-card__dot--yellow {
    background: #fbbf24;
  }

  .featured-card__dot--green {
    background: #4ade80;
  }

  .featured-card__path {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: #94a3b8;
    font-family: var(--font-family-mono);
    font-size: 12px;
    white-space: nowrap;
  }

  .featured-card__body {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: var(--space-6);
    flex: 1;
    min-height: 320px;
    padding: var(--space-6);
  }

  .featured-card__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .featured-card__prompt {
    margin: 0;
    color: #60a5fa;
    font-family: var(--font-family-mono);
    font-size: 13px;
  }

  .featured-card__title {
    margin: 0;
    color: #e5e7eb;
    font-size: 28px;
    line-height: 1.25;
  }

  .featured-card__link {
    color: inherit;
    text-decoration: none;
  }

  .featured-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .featured-card__summary {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: #cbd5e1;
    font-size: 15px;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .featured-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
  }

  .featured-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured-card__cover {
    min-height: 180px;
  }

  .featured-card__cover img {
    display: block;
    width: 100%;
    height: 100%;
    border: var(--border-width) solid #334155;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  @media (max-width: 47.999rem) {
    .featured-card__body {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding: var(--space-4);
    }

    .featured-card__title {
      font-size: 24px;
    }

    .featured-card__cover {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }
</style>

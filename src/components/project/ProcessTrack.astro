---
import { STAGES } from '../../lib/constants';
---

<ol class="process-track">
  {
    STAGES.map((stage) => (
      <li class="process-track__item">
        <a class="process-track__link" href="/about/#process">
          <span class="process-track__index">{stage.stage}</span>
          <span class="process-track__name">{stage.name}</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .process-track {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-track__item {
    position: relative;
    min-width: 0;
  }

  .process-track__item::before {
    content: '';
    position: absolute;
    top: 7px;
    right: 0;
    left: 0;
    height: 2px;
    background: var(--color-border);
  }

  .process-track__item:first-child::before {
    left: 50%;
  }

  .process-track__item:last-child::before {
    right: 50%;
  }

  .process-track__link {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding-top: var(--space-4);
    color: var(--color-text-secondary);
    text-align: center;
    text-decoration: none;
  }

  .process-track__link::before {
    content: '';
    position: absolute;
    top: 2px;
    left: 50%;
    width: 12px;
    height: 12px;
    transform: translateX(-50%);
    border: 2px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-page);
  }

  .process-track__link:hover .process-track__name {
    color: var(--color-brand);
  }

  .process-track__index {
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    font-size: 11px;
  }

  .process-track__name {
    font-size: 13px;
    line-height: 1.4;
  }

  @media (max-width: 47.999rem) {
    .process-track {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .process-track__item::before {
      top: 0;
      bottom: 0;
      left: 7px;
      width: 2px;
      height: auto;
    }

    .process-track__item:first-child::before {
      top: 50%;
      left: 7px;
    }

    .process-track__item:last-child::before {
      right: auto;
      bottom: 50%;
    }

    .process-track__link {
      grid-template-columns: 24px minmax(0, 1fr);
      justify-items: start;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-3) 0;
      text-align: left;
    }

    .process-track__link::before {
      top: 50%;
      left: 7px;
      transform: translate(-50%, -50%);
    }
  }
</style>
